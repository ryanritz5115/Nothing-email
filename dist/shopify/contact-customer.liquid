              {%- assign stack_body    = 'Click below to contact support.' -%}
              {%- assign stack_tag     = 'h2' -%}
              {%- comment -%}
  Text stack. Eyebrow, headline, body. Opens every email and the support footer.
  Place inside a <td>. Reads tone.
  Inputs, reset after use:
    stack_eyebrow  small bold line above the headline (optional)
    stack_title    headline
    stack_body     paragraph under the headline (optional)
    stack_tag      'h1' (default) or 'h2'
{%- endcomment -%}
{%- comment -%}
  Tone. Sets the tone_* colors that tone-aware components read.
  Set tone = 'dark' before a component on a black background, and back to
  'light' after. Anything else (or unset) is light.
{%- endcomment -%}
{%- if tone == 'dark' -%}
  {%- assign tone_text        = c_white -%}
  {%- assign tone_link        = c_white -%}
  {%- assign tone_button_bg   = c_white -%}
  {%- assign tone_button_text = c_black -%}
{%- else -%}
  {%- assign tone_text        = c_black -%}
  {%- assign tone_link        = c_brand -%}
  {%- assign tone_button_bg   = c_brand -%}
  {%- assign tone_button_text = c_white -%}
{%- endif -%}

{%- if stack_tag == blank -%}{%- assign stack_tag = 'h1' -%}{%- endif -%}
{%- if stack_eyebrow != blank -%}
  <p style="{{ st_small_bold }} color:{{ tone_text }};">{{ stack_eyebrow }}</p>
{%- endif -%}
<{{ stack_tag }} style="{{ st_serif }} color:{{ tone_text }};{%- if stack_eyebrow != blank %} padding-top:{{ space_xs }};{%- endif -%}">{{ stack_title }}</{{ stack_tag }}>
{%- if stack_body != blank -%}
  <p style="{{ st_body }} color:{{ tone_text }}; padding-top:{{ space_sm }};">{{ stack_body }}</p>
{%- endif -%}
{%- assign stack_eyebrow = '' -%}
{%- assign stack_title   = '' -%}
{%- assign stack_body    = '' -%}
{%- assign stack_tag     = '' -%}


              {%- assign button_label = 'Contact Support' -%}
              {%- assign button_url   = support_url -%}
              {%- assign link_prefix  = 'or email us directly at' -%}
              {%- assign link_label   = support_email | escape -%}
              {%- assign link_url     = 'mailto:' | append: support_email | escape -%}
              {%- comment -%}
  Actions. A bulletproof pill button, then an optional "or <link>" line.
  Place inside a <td>, after a text stack or card. Reads tone.
  Inputs, reset after use:
    button_label, button_url  the button
    link_prefix               text before the secondary link, e.g. 'or' (optional)
    link_label, link_url      the secondary link (optional)
{%- endcomment -%}
{%- comment -%}
  Tone. Sets the tone_* colors that tone-aware components read.
  Set tone = 'dark' before a component on a black background, and back to
  'light' after. Anything else (or unset) is light.
{%- endcomment -%}
{%- if tone == 'dark' -%}
  {%- assign tone_text        = c_white -%}
  {%- assign tone_link        = c_white -%}
  {%- assign tone_button_bg   = c_white -%}
  {%- assign tone_button_text = c_black -%}
{%- else -%}
  {%- assign tone_text        = c_black -%}
  {%- assign tone_link        = c_brand -%}
  {%- assign tone_button_bg   = c_brand -%}
  {%- assign tone_button_text = c_white -%}
{%- endif -%}

<table role="presentation" cellpadding="0" cellspacing="0" border="0" style="margin-top:{{ space_lg }};">
  <tr>
    <td align="center" bgcolor="{{ tone_button_bg }}" style="border-radius:{{ radius_button }}; background-color:{{ tone_button_bg }};">
      <a href="{{ button_url }}" target="_blank" style="display:inline-block; padding:{{ button_padding }}; font-family:{{ font_sans }}; font-size:{{ size_body }}; font-weight:{{ weight_bold }}; line-height:1; color:{{ tone_button_text }}; text-decoration:none; border-radius:{{ radius_button }};">{{ button_label }}</a>
    </td>
  </tr>
</table>
{%- if link_label != blank -%}
  <p style="{{ st_body }} color:{{ tone_text }}; padding-top:{{ space_md }};">{{ link_prefix }} <a href="{{ link_url }}" target="_blank" style="font-weight:{{ weight_bold }}; color:{{ tone_link }}; text-decoration:none;">{{ link_label }}</a></p>
{%- endif -%}
{%- assign button_label = '' -%}
{%- assign button_url   = '' -%}
{%- assign link_prefix  = '' -%}
{%- assign link_label   = '' -%}
{%- assign link_url     = '' -%}


              {%- assign tone = 'light' -%}
            </td>
          </tr>
        </table>
      </td>
    </tr>

