{%- assign email_title = 'Your gift card receipt' -%}
{%- assign footer_support_title = 'Need help with your gift card?' -%}
{%- assign receipt_recipient_full_name = gift_card.recipient.name | strip -%}
{%- assign receipt_recipient_email = gift_card.recipient.email | strip -%}
{%- assign receipt_recipient_name = gift_card.recipient.nickname | strip | default: receipt_recipient_full_name | default: receipt_recipient_email -%}
{%- assign receipt_send_on = gift_card.send_on | strip -%}
{%- assign receipt_gift_code = gift_card.code | strip -%}
{%- capture receipt_recipient -%}
  {{- receipt_recipient_name | escape -}}
  {%- if receipt_recipient_email != blank and receipt_recipient_email != receipt_recipient_name %} ({{ receipt_recipient_email | escape }}){% endif -%}
{%- endcapture -%}
{%- capture receipt_delivery -%}
  {%- if receipt_send_on != blank -%}
    Your gift card{% if receipt_recipient_name != blank %} for {{ receipt_recipient }}{% endif %} is scheduled to be sent on {{ receipt_send_on | date: '%B %e, %Y' | escape }}.
  {%- elsif receipt_recipient_name != blank -%}
    Your gift card was sent to {{ receipt_recipient }}.
  {%- else -%}
    Keep this copy of your gift card details for your records.
  {%- endif -%}
{%- endcapture -%}
{%- assign preheader = receipt_delivery -%}
{%- capture email_styles -%}
  {%- comment -%} Responsive styles shared by gift cards and store credit. {%- endcomment -%}
@media only screen and (max-width: {{ footer_breakpoint }}) {
  .pr-gc-gutter { padding-left:{{ space_gutter }} !important; padding-right:{{ space_gutter }} !important; }
  .pr-gc-title { font-size:{{ gc_size_title_mobile }} !important; }
  .pr-gc-heading { font-size:{{ gc_size_heading_mobile }} !important; }
  .pr-gc-amount { font-size:{{ gc_size_amount_mobile }} !important; }
  .pr-gc-step { font-size:{{ gc_size_step_mobile }} !important; }
}

{%- endcapture -%}

{%- comment -%}
  Opens the document: head, preheader, page wrapper, container, logo.
  Set before including: email_title, preheader. Optional: email_styles.
{%- endcomment -%}
<!DOCTYPE html>
<html lang="en" style="color-scheme:only light;">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="color-scheme" content="light only">
  <meta name="supported-color-schemes" content="light only">
  <title>{{ email_title }}</title>
  <style>
    :root { color-scheme: only light; }
    body { margin:0; padding:0; -webkit-text-size-adjust:100%; background-color:{{ c_white }}; color:{{ c_black }}; color-scheme:only light; }
    img { border:0; outline:none; text-decoration:none; display:block; }
    a { text-decoration:none; }
    .pr-message p { margin:0 0 {{ space_sm }}; }
    .pr-message a { color:{{ c_brand }}; font-weight:{{ weight_bold }}; }
    .pr-message img { max-width:100%; height:auto; }
    @media only screen and (max-width: {{ footer_breakpoint }}) {
      .pr-brand, .pr-social { display:block !important; width:100% !important; }
      .pr-brand { padding-right:0 !important; padding-bottom:{{ space_lg }} !important; }
      .pr-social-icon { width:{{ social_icon_mobile }}px !important; height:{{ social_icon_mobile }}px !important; }
    }
    {%- if email_styles != blank %}
      {{ email_styles }}
    {%- endif %}
  </style>
</head>
<body bgcolor="{{ c_white }}" style="margin:0; padding:0; background-color:{{ c_white }}; color:{{ c_black }}; color-scheme:only light;">

  <div style="display:none; max-height:0; overflow:hidden; opacity:0; mso-hide:all;">{{ preheader }}</div>

  <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" bgcolor="{{ c_white }}" style="width:100%; background-color:{{ c_white }}; color:{{ c_black }};">
    <tr>
      <td align="center">
        <table role="presentation" width="{{ container_width }}" cellpadding="0" cellspacing="0" border="0" bgcolor="{{ c_white }}" style="width:100%; max-width:{{ container_width }}px; background-color:{{ c_white }}; color:{{ c_black }};">

          <tr>
            <td style="padding:0 0 {{ space_lg }};">
              <a href="{{ store_url }}" target="_blank">
                <img src="{{ img_logo }}" width="{{ container_width }}" alt="Porrada Performance Nutrition" style="display:block; width:100%; max-width:{{ container_width }}px; height:auto;">
              </a>
            </td>
          </tr>

<tr>
  <td align="center">
    {%- comment -%}
  Purchaser gift-card receipt in the shared centered gift design.
  Requires shared config and receipt identity/delivery logic.
{%- endcomment -%}
<table role="presentation" width="{{ gc_width }}" cellpadding="0" cellspacing="0" border="0" style="width:100%; max-width:{{ gc_width }}px; border-collapse:collapse;">
  <tr>
    <td class="pr-gc-gutter pr-gc-title" align="center" style="padding:{{ gc_pad_title }}; {{ st_gc_title }}">
      {{ email_title }}
    </td>
  </tr>
  <tr>
    <td class="pr-gc-gutter" align="center" style="padding:{{ gc_pad_intro }}; {{ st_gc_body }}">
      {{ receipt_delivery }}
      {%- if receipt_send_on != blank or receipt_recipient_name != blank %} Keep this copy for your records.{% endif -%}
    </td>
  </tr>
  {%- if gift_card.message != blank -%}
    <tr>
      <td class="pr-gc-gutter" align="center" style="padding:{{ gc_pad_message }}; {{ st_gc_message }}">
        &ldquo;{{ gift_card.message | escape | newline_to_br }}&rdquo;
      </td>
    </tr>
  {%- endif -%}
  <tr>
    <td class="pr-gc-gutter" align="center" style="padding:{{ gc_pad_image }};">
      <img src="{{ img_gift_card }}" alt="Porrada gift card" width="{{ gc_image_width }}" style="display:block; width:100%; max-width:{{ gc_image_width }}px; height:auto; border-radius:{{ gc_radius_image }}; margin:0 auto;">
    </td>
  </tr>
  {%- if gift_card.initial_value != blank -%}
    <tr>
      <td class="pr-gc-gutter pr-gc-amount" align="center" style="padding:{{ gc_pad_amount }}; {{ st_gc_amount }}">
        {{ gift_card.initial_value | money }}
      </td>
    </tr>
  {%- endif -%}
  {%- if gift_card.expires_on != blank -%}
    <tr>
      <td class="pr-gc-gutter" align="center" style="padding:{{ gc_pad_note }}; {{ st_gc_note }}">
        Expires {{ gift_card.expires_on | date: '%B %e, %Y' | escape }}
      </td>
    </tr>
  {%- endif -%}
  {%- if receipt_gift_code != blank -%}
    <tr>
      <td class="pr-gc-gutter" align="center" style="padding:{{ gc_pad_code }}; {{ st_gc_code_label }}">
        Gift card code<br>
        <span style="{{ st_gc_code }}">{{ receipt_gift_code | format_code | escape }}</span>
      </td>
    </tr>
  {%- endif -%}
  <tr>
    <td class="pr-gc-gutter" align="center" style="padding:{{ gc_pad_action }};">
      <table role="presentation" cellpadding="0" cellspacing="0" border="0" style="border-collapse:collapse;">
        <tr>
          <td align="center" bgcolor="{{ c_brand }}" style="border-radius:{{ radius_button }}; background-color:{{ c_brand }};">
            <a href="{{ orders_url }}" target="_blank" style="{{ st_gc_button }}">View your order</a>
          </td>
        </tr>
      </table>
    </td>
  </tr>
</table>

  </td>
</tr>
