{%- endif -%}
{%- assign button_label = '' -%}
{%- assign button_url   = '' -%}
{%- assign link_prefix  = '' -%}
{%- assign link_label   = '' -%}
{%- assign link_url     = '' -%}


              {%- assign tone = 'light' -%}
