{%- comment -%} ======================= ORDER LOGIC ======================= {%- endcomment -%}

{%- comment -%} Headline + intro copy {%- endcomment -%}
{%- if has_pending_payment -%}
  {%- assign email_title = 'Thank you for your order!' -%}
  {%- if buyer_action_required -%}
    {%- assign email_body = "Complete your payment to confirm your order. You'll get a confirmation email once it goes through." -%}
  {%- else -%}
    {%- assign email_body = "Your payment is being processed. You'll get an email when your order is confirmed." -%}
  {%- endif -%}
{%- else -%}
  {%- assign email_title = 'Thank you for your purchase!' -%}
  {%- if requires_shipping -%}
    {%- case delivery_method -%}
      {%- when 'pick-up' -%}
        {%- assign email_body = "You'll receive an email when your order is ready for pickup." -%}
      {%- when 'local' -%}
        {%- assign email_body = "We're getting your order ready for delivery." -%}
      {%- else -%}
        {%- assign email_body = 'You will receive an email with your products shortly.' -%}
    {%- endcase -%}
  {%- else -%}
    {%- assign email_body = 'Your order is confirmed.' -%}
  {%- endif -%}
{%- endif -%}

{%- assign preheader = 'Order ' | append: order_name | append: " confirmed. Here's your summary." -%}

{%- comment -%} Gift card note {%- endcomment -%}
{%- assign gift_card_note = '' -%}
{%- assign gift_card_lines = line_items | where: 'gift_card' -%}
{%- if gift_card_lines.size > 0 -%}
  {%- assign gift_card_to_recipient = false -%}
  {%- for gl in gift_card_lines -%}
    {%- if gl.properties['__shopify_send_gift_card_to_recipient'] and gl.properties['Recipient email'] -%}
      {%- assign gift_card_to_recipient = true -%}
      {%- break -%}
    {%- endif -%}
  {%- endfor -%}
  {%- if gift_card_to_recipient -%}
    {%- assign gift_card_note = 'Your gift card recipient will receive an email with their gift card code.' -%}
  {%- else -%}
    {%- assign gift_card_note = "You'll receive separate emails for any gift cards." -%}
  {%- endif -%}
{%- endif -%}

{%- comment -%} Discounts: order-level and shipping {%- endcomment -%}
{%- assign order_discount_count    = 0 -%}
{%- assign order_discount_total    = 0 -%}
{%- assign shipping_discount_total = 0 -%}
{%- assign has_shipping_discount   = false -%}
{%- for app in discount_applications -%}
  {%- if app.target_selection == 'all' and app.target_type == 'line_item' -%}
    {%- assign order_discount_count = order_discount_count | plus: 1 -%}
    {%- assign order_discount_total = order_discount_total | plus: app.total_allocated_amount -%}
  {%- elsif app.target_type == 'shipping_line' -%}
    {%- assign has_shipping_discount = true -%}
    {%- assign shipping_discount_total = shipping_discount_total | plus: app.total_allocated_amount -%}
  {%- endif -%}
{%- endfor -%}
{%- assign shipping_original = shipping_price | plus: shipping_discount_total -%}

{%- comment -%} Delivery labels {%- endcomment -%}
{%- case delivery_method -%}
  {%- when 'pick-up' -%}
    {%- assign delivery_label = 'Pickup' -%}
    {%- assign method_label   = 'Pickup' -%}
    {%- assign address_label  = '' -%}
  {%- when 'local' -%}
    {%- assign delivery_label = 'Delivery' -%}
    {%- assign method_label   = 'Delivery method' -%}
    {%- assign address_label  = 'Delivery address' -%}
  {%- else -%}
    {%- assign delivery_label = 'Shipping' -%}
    {%- assign method_label   = 'Shipping method' -%}
    {%- assign address_label  = 'Shipping address' -%}
{%- endcase -%}

{%- comment -%} Payments {%- endcomment -%}
{%- assign paid_amount       = 0 -%}
{%- assign authorized_amount = 0 -%}
{%- assign refunded_amount   = 0 -%}
{%- assign payment_count     = 0 -%}
{%- for t in transactions -%}
  {%- if t.status == 'success' -%}
    {%- case t.kind -%}
      {%- when 'sale', 'capture' -%}
        {%- assign paid_amount = paid_amount | plus: t.amount -%}
        {%- assign payment_count = payment_count | plus: 1 -%}
      {%- when 'authorization' -%}
        {%- assign authorized_amount = authorized_amount | plus: t.amount -%}
        {%- assign payment_count = payment_count | plus: 1 -%}
      {%- when 'refund' -%}
        {%- assign refunded_amount = refunded_amount | plus: t.amount -%}
    {%- endcase -%}
  {%- endif -%}
{%- endfor -%}

{%- assign show_paid_today = false -%}
{%- if paid_amount > 0 -%}
  {%- if show_paid_today_always or paid_amount != total_price or total_outstanding > 0 -%}
    {%- assign show_paid_today = true -%}
  {%- endif -%}
{%- endif -%}

{%- assign show_ship_address = false -%}
{%- if requires_shipping and shipping_address and delivery_method != 'pick-up' -%}
  {%- assign show_ship_address = true -%}
{%- endif -%}

{%- assign address = shipping_address -%}
{%- capture ship_address_lines -%}{%- comment -%}
  Address. Outputs an address as lines joined by <br>, skipping blank
  company and address2. Capture it and pass it as a detail value.
  Built from fields on purpose: Shopify's format_address wraps its output in
  its own <p>, which breaks out of the surrounding styles in Gmail.
  Input, reset after use:
    address  a Shopify address
{%- endcomment -%}
{{- address.name }}<br>
{%- if address.company != blank %}{{ address.company }}<br>{% endif -%}
{{- address.address1 }}<br>
{%- if address.address2 != blank %}{{ address.address2 }}<br>{% endif -%}
{{- address.city }} {{ address.province_code }} {{ address.zip }}<br>
{{- address.country -}}
{%- assign address = nil -%}
{%- endcapture -%}
{%- assign address = billing_address -%}
{%- capture bill_address_lines -%}{%- comment -%}
  Address. Outputs an address as lines joined by <br>, skipping blank
  company and address2. Capture it and pass it as a detail value.
  Built from fields on purpose: Shopify's format_address wraps its output in
  its own <p>, which breaks out of the surrounding styles in Gmail.
  Input, reset after use:
    address  a Shopify address
{%- endcomment -%}
{{- address.name }}<br>
{%- if address.company != blank %}{{ address.company }}<br>{% endif -%}
{{- address.address1 }}<br>
{%- if address.address2 != blank %}{{ address.address2 }}<br>{% endif -%}
{{- address.city }} {{ address.province_code }} {{ address.zip }}<br>
{{- address.country -}}
{%- assign address = nil -%}
{%- endcapture -%}

{%- comment -%} ========================= DOCUMENT ========================= {%- endcomment -%}

{%- comment -%}
  Opens the document: head, preheader, page wrapper, container, logo.
  Set before including: email_title, preheader. Optional: email_styles.
{%- endcomment -%}
<!DOCTYPE html>
<html lang="en" style="color-scheme:only light;">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="color-scheme" content="light only">
  <meta name="supported-color-schemes" content="light only">
  <title>{{ email_title }}</title>
  <style>
    :root { color-scheme: only light; }
    body { margin:0; padding:0; -webkit-text-size-adjust:100%; background-color:{{ c_white }}; color:{{ c_black }}; color-scheme:only light; }
    img { border:0; outline:none; text-decoration:none; display:block; }
    a { text-decoration:none; }
    .pr-message p { margin:0 0 {{ space_sm }}; }
    .pr-message a { color:{{ c_brand }}; font-weight:{{ weight_bold }}; }
    .pr-message img { max-width:100%; height:auto; }
    @media only screen and (max-width: {{ footer_breakpoint }}) {
      .pr-brand, .pr-social { display:block !important; width:100% !important; }
      .pr-brand { padding-right:0 !important; padding-bottom:{{ space_lg }} !important; }
      .pr-social-icon { width:{{ social_icon_mobile }}px !important; height:{{ social_icon_mobile }}px !important; }
    }
    {%- if email_styles != blank %}
      {{ email_styles }}
    {%- endif %}
  </style>
</head>
<body bgcolor="{{ c_white }}" style="margin:0; padding:0; background-color:{{ c_white }}; color:{{ c_black }}; color-scheme:only light;">

  <div style="display:none; max-height:0; overflow:hidden; opacity:0; mso-hide:all;">{{ preheader }}</div>

  <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" bgcolor="{{ c_white }}" style="width:100%; background-color:{{ c_white }}; color:{{ c_black }};">
    <tr>
      <td align="center">
        <table role="presentation" width="{{ container_width }}" cellpadding="0" cellspacing="0" border="0" bgcolor="{{ c_white }}" style="width:100%; max-width:{{ container_width }}px; background-color:{{ c_white }}; color:{{ c_black }};">

          <tr>
            <td style="padding:0 0 {{ space_lg }};">
              <a href="{{ store_url }}" target="_blank">
                <img src="{{ img_logo }}" width="{{ container_width }}" alt="{{ brand_name }}" style="display:block; width:100%; max-width:{{ container_width }}px; height:auto;">
              </a>
            </td>
          </tr>


          {%- comment -%} ===== HERO ===== {%- endcomment -%}
          <tr>
            <td style="padding:0 {{ space_gutter }};">
              {%- assign stack_eyebrow = 'Order ' | append: order_name -%}
              {%- assign stack_title   = email_title -%}
              {%- assign stack_body    = email_body -%}
              {%- comment -%}
  Text stack. Eyebrow, headline, body. Opens every email and the support footer.
  Place inside a <td>. Reads tone.
  Inputs, reset after use:
    stack_eyebrow  small bold line above the headline (optional)
    stack_title    headline
    stack_body     paragraph under the headline (optional)
    stack_tag      'h1' (default) or 'h2'
{%- endcomment -%}
{%- comment -%}
  Tone. Sets the tone_* colors that tone-aware components read.
  Set tone = 'dark' before a component on a black background, and back to
  'light' after. Anything else (or unset) is light.
{%- endcomment -%}
{%- if tone == 'dark' -%}
  {%- assign tone_text        = c_white -%}
  {%- assign tone_link        = c_white -%}
  {%- assign tone_button_bg   = c_white -%}
  {%- assign tone_button_text = c_black -%}
{%- else -%}
  {%- assign tone_text        = c_black -%}
  {%- assign tone_link        = c_brand -%}
  {%- assign tone_button_bg   = c_brand -%}
  {%- assign tone_button_text = c_white -%}
{%- endif -%}

{%- if stack_tag == blank -%}{%- assign stack_tag = 'h1' -%}{%- endif -%}
{%- if stack_eyebrow != blank -%}
  <p style="{{ st_small_bold }} color:{{ tone_text }};">{{ stack_eyebrow }}</p>
{%- endif -%}
<{{ stack_tag }} style="{{ st_serif }} color:{{ tone_text }};{%- if stack_eyebrow != blank %} padding-top:{{ space_xs }};{%- endif -%}">{{ stack_title }}</{{ stack_tag }}>
{%- if stack_body != blank -%}
