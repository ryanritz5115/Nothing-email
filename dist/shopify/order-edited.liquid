{%- comment -%}
  Order payment ledger for cancellation, refund, and edit notifications.
  Shopify's transactions array belongs to the whole order. These totals
  are lifetime amounts, never the amount of the current refund event.
  Only successful sale/capture transactions count as collected money.
  An authorization is not a charge, and a pending/failed refund is not
  money returned. Refund-event `amount` is read separately by its template.
  Contract: https://help.shopify.com/en/manual/fulfillment/setup/notifications/email-variables
            https://shopify.dev/docs/api/liquid/objects/transaction
{%- endcomment -%}
{%- assign payment_collected_amount = 0 -%}
{%- assign payment_authorized_amount = 0 -%}
{%- assign payment_refunded_amount = 0 -%}
{%- assign payment_pending_refund_amount = 0 -%}
{%- assign payment_problem_refund_amount = 0 -%}
{%- assign payment_has_refund_records = false -%}
{%- assign payment_has_pending_refund = false -%}
{%- assign payment_has_problem_refund = false -%}
{%- assign payment_has_unknown_refund = false -%}
{%- assign payment_has_gift_card_refund = false -%}
{%- assign payment_has_store_credit_refund = false -%}
{%- assign payment_has_external_refund = false -%}
{%- assign payment_has_shopify_payments_refund = false -%}
{%- assign payment_has_subscription = false -%}

{%- for payment_transaction in transactions -%}
  {%- if payment_transaction.kind == 'refund' -%}
    {%- assign payment_has_refund_records = true -%}
    {%- case payment_transaction.status -%}
      {%- when 'success' -%}
        {%- if payment_transaction.amount and payment_transaction.amount > 0 -%}
          {%- assign payment_refunded_amount = payment_refunded_amount | plus: payment_transaction.amount -%}
        {%- endif -%}
      {%- when 'pending' -%}
        {%- assign payment_has_pending_refund = true -%}
        {%- if payment_transaction.amount and payment_transaction.amount > 0 -%}
          {%- assign payment_pending_refund_amount = payment_pending_refund_amount | plus: payment_transaction.amount -%}
        {%- endif -%}
      {%- when 'failure', 'error' -%}
        {%- assign payment_has_problem_refund = true -%}
        {%- if payment_transaction.amount and payment_transaction.amount > 0 -%}
          {%- assign payment_problem_refund_amount = payment_problem_refund_amount | plus: payment_transaction.amount -%}
        {%- endif -%}
      {%- else -%}
        {%- assign payment_has_unknown_refund = true -%}
    {%- endcase -%}
    {%- if payment_transaction.gateway == 'gift_card' -%}
      {%- assign payment_has_gift_card_refund = true -%}
    {%- elsif payment_transaction.gateway == 'shopify_store_credit' -%}
      {%- assign payment_has_store_credit_refund = true -%}
    {%- else -%}
      {%- assign payment_has_external_refund = true -%}
      {%- if payment_transaction.gateway == 'shopify_payments' -%}
        {%- assign payment_has_shopify_payments_refund = true -%}
      {%- endif -%}
    {%- endif -%}
  {%- elsif payment_transaction.status == 'success' and payment_transaction.amount and payment_transaction.amount > 0 -%}
    {%- case payment_transaction.kind -%}
      {%- when 'sale', 'capture' -%}
        {%- assign payment_collected_amount = payment_collected_amount | plus: payment_transaction.amount -%}
      {%- when 'authorization' -%}
        {%- assign payment_authorized_amount = payment_authorized_amount | plus: payment_transaction.amount -%}
    {%- endcase -%}
  {%- endif -%}
{%- endfor -%}

{%- for payment_order_line in subtotal_line_items -%}
  {%- if payment_order_line.selling_plan_allocation -%}
    {%- assign payment_has_subscription = true -%}
    {%- break -%}
  {%- endif -%}
{%- endfor -%}
{%- unless payment_has_subscription -%}
  {%- for payment_order_line in line_items -%}
    {%- if payment_order_line.selling_plan_allocation -%}
      {%- assign payment_has_subscription = true -%}
      {%- break -%}
    {%- endif -%}
  {%- endfor -%}
{%- endunless -%}
{%- unless payment_has_subscription -%}
  {%- for payment_refund_line in refund_line_items -%}
    {%- if payment_refund_line.line_item.selling_plan_allocation -%}
      {%- assign payment_has_subscription = true -%}
      {%- break -%}
    {%- endif -%}
  {%- endfor -%}
{%- endunless -%}


{%- comment -%}
  An edit can leave money due, money owed back, or no balance. It does not
  itself collect payment or issue a refund. Keep historical successful
  refunds separate from the remaining balance. A missing balance is unknown,
  never zero. total_outstanding is also used by the order confirmation.
{%- endcomment -%}
{%- assign email_title = 'Your order has been updated' -%}
{%- assign email_body = 'Please review your updated items and totals below. Contact us if anything looks wrong.' -%}
{%- assign preheader = 'Order ' | append: order_name | append: ' has been updated. Review your latest summary.' -%}
{%- assign edit_balance_known = false -%}
{%- assign edit_balance_label = 'Payment details' -%}
{%- assign edit_balance_value = 'View your order for the latest balance, or contact us for help.' -%}
{%- assign edit_payment_next_step = 'View your order for the latest payment details. Contact us if you need help confirming the balance.' -%}

{%- if total_outstanding != blank -%}
  {%- assign edit_balance_known = true -%}
  {%- if total_outstanding > 0 -%}
    {%- assign edit_balance_label = 'Amount due' -%}
    {%- assign edit_balance_value = total_outstanding | money_with_currency -%}
    {%- if payment_terms.next_payment.due_at -%}
      {%- capture edit_balance_label -%}Amount due by {{ payment_terms.next_payment.due_at | date: '%b %-d, %Y' }}{%- endcapture -%}
    {%- endif -%}
    {%- assign edit_payment_next_step = 'A balance remains on your order. If you received an invoice email, use its payment link. Contact us if you need help paying.' -%}
  {%- elsif total_outstanding < 0 -%}
    {%- assign edit_balance_label = 'Refund still owed' -%}
    {%- assign edit_balance_value = total_outstanding | abs | money_with_currency -%}
    {%- assign edit_payment_next_step = "We still owe you the amount shown above. You'll receive a separate refund update when it is issued. Contact us if you have questions." -%}
  {%- else -%}
    {%- assign edit_balance_label = 'Amount due' -%}
    {%- assign edit_balance_value = total_outstanding | money_with_currency -%}
    {%- assign edit_payment_next_step = 'No additional payment is due on this order. Keep this email as a record of the update.' -%}
  {%- endif -%}
{%- endif -%}

{%- if payment_has_pending_refund -%}
  {%- assign edit_payment_next_step = edit_payment_next_step | append: ' A refund is processing. The time it takes to appear depends on your payment provider.' -%}
{%- endif -%}

{%- assign updated_item_count = 0 -%}
{%- assign updated_items_known = false -%}
{%- if subtotal_line_items != nil -%}{%- assign updated_items_known = true -%}{%- endif -%}
{%- for line in subtotal_line_items -%}
  {%- assign updated_quantity = line.quantity -%}
  {%- if line.current_quantity != nil -%}
    {%- assign updated_quantity = line.current_quantity -%}
  {%- endif -%}
  {%- if updated_quantity > 0 -%}
    {%- assign updated_item_count = updated_item_count | plus: updated_quantity -%}
  {%- endif -%}
{%- endfor -%}

{%- comment -%}
  Opens the document: head, preheader, page wrapper, container, logo.
  Set before including: email_title, preheader. Optional: email_styles.
{%- endcomment -%}
<!DOCTYPE html>
<html lang="en" style="color-scheme:only light;">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
