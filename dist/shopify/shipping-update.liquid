<{{ stack_tag }} style="{{ st_serif }} color:{{ tone_text }};{%- if stack_eyebrow != blank %} padding-top:{{ space_xs }};{%- endif -%}">{{ stack_title }}</{{ stack_tag }}>
{%- if stack_body != blank -%}
