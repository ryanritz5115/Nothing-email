{%- comment -%}
=====================================================================
  PORRADA EMAIL · SHIPMENT LOGIC
  Included right after config by every template about one shipment
  (Shopify's fulfillment object). Computes what the shipment-*
  components read:
    delivery_date       'Friday, October 23', or '' with no estimate
    tracking_count      number of tracking numbers
    tracking_label      'UPS tracking number(s)' or 'Tracking number(s)'
    tracking_links      each number, linked when it has a URL, one per line
    track_url           the link for a Track button: one package with a URL, else ''
    ship_address_lines  the shipping address as lines
=====================================================================
{%- endcomment -%}

{%- comment -%} Estimated delivery {%- endcomment -%}
{%- assign delivery_date = '' -%}
{%- if fulfillment.estimated_delivery_at -%}
  {%- assign delivery_date = fulfillment.estimated_delivery_at | date: '%A, %B %-d' -%}
{%- endif -%}

{%- comment -%} Tracking. One package with a link gets a Track button; anything else lists links in the card. {%- endcomment -%}
{%- assign tracking_count = fulfillment.tracking_numbers.size | default: 0 -%}
{%- if fulfillment.tracking_company != blank -%}
  {%- assign tracking_label = fulfillment.tracking_company | append: ' tracking number' -%}
{%- else -%}
  {%- assign tracking_label = 'Tracking number' -%}
{%- endif -%}
{%- if tracking_count > 1 -%}
  {%- assign tracking_label = tracking_label | append: 's' -%}
{%- endif -%}

{%- capture tracking_links -%}
  {%- for number in fulfillment.tracking_numbers -%}
    {%- assign number_url = fulfillment.tracking_urls[forloop.index0] -%}
    {%- if number_url != blank -%}
      <a href="{{ number_url }}" target="_blank" style="font-weight:{{ weight_bold }}; color:{{ c_brand }}; text-decoration:none;">{{ number | escape }}</a>
    {%- else -%}
      {{ number | escape }}
    {%- endif -%}
    {%- unless forloop.last -%}<br>{%- endunless -%}
  {%- endfor -%}
{%- endcapture -%}

{%- assign track_url = '' -%}
{%- if tracking_count == 1 -%}
  {%- if fulfillment.tracking_urls.first != blank -%}
    {%- assign track_url = fulfillment.tracking_urls.first -%}
  {%- elsif fulfillment.tracking_url != blank -%}
    {%- assign track_url = fulfillment.tracking_url -%}
  {%- endif -%}
{%- endif -%}

{%- assign address = shipping_address -%}
{%- capture ship_address_lines -%}{%- comment -%}
  Address. Outputs an address as lines joined by <br>, skipping blank
  company and address2. Capture it and pass it as a detail value.
  Built from fields on purpose: Shopify's format_address wraps its output in
  its own <p>, which breaks out of the surrounding styles in Gmail.
  Input, reset after use:
    address  a Shopify address
{%- endcomment -%}
{{- address.name }}<br>
{%- if address.company != blank %}{{ address.company }}<br>{% endif -%}
{{- address.address1 }}<br>
{%- if address.address2 != blank %}{{ address.address2 }}<br>{% endif -%}
{{- address.city }} {{ address.province_code }} {{ address.zip }}<br>
{{- address.country -}}
{%- assign address = nil -%}
{%- endcapture -%}


{%- comment -%} ======================= UPDATE LOGIC ======================= {%- endcomment -%}

{%- comment -%} Headline + intro copy. Lead with reassurance: an update email can read like a problem. {%- endcomment -%}
{%- if tracking_count > 1 -%}
  {%- assign email_title = 'Your tracking has been updated' -%}
  {%- assign email_body  = "We've updated the tracking details for this shipment. Use the numbers below to check each package." -%}
  {%- assign preheader   = 'New tracking for order ' | append: order_name | append: '.' -%}
{%- elsif tracking_count == 1 -%}
  {%- assign email_title = 'Your tracking has been updated' -%}
  {%- assign email_body  = "We've updated the tracking details for this shipment. Use the latest number below to check its progress." -%}
  {%- assign preheader   = 'New tracking for order ' | append: order_name | append: '.' -%}
{%- else -%}
  {%- assign email_title = 'Your shipping info has been updated' -%}
  {%- assign email_body  = 'The shipping details for this shipment have changed. Your latest available information is below. Contact support if you need help checking its progress.' -%}
  {%- assign preheader   = 'Shipping update for order ' | append: order_name | append: '.' -%}
{%- endif -%}

{%- if fulfillment.item_count and item_count and fulfillment.item_count < item_count -%}
  {%- assign email_body = email_body | append: ' This update covers part of your order. Other items may arrive separately.' -%}
{%- endif -%}

{%- if delivery_date != '' -%}
  {%- assign preheader = preheader | append: ' Estimated delivery ' | append: delivery_date | append: '.' -%}
{%- endif -%}

{%- comment -%} ========================= DOCUMENT ========================= {%- endcomment -%}

