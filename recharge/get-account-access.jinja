{# Recharge > Notifications > Get account access.
   The documented account invite may vary by customer status. No undocumented flags
   are assumed here: the store's /account route owns sign-in and account setup.
   Do not restore a tokenized subscription_url, login_url or activation URL. #}
{% include 'shared/config' %}
{% set email_title = 'Access your ' ~ brand_name ~ ' account' %}
{% set preheader = 'Open your account and follow the steps to sign in.' %}
{% set recharge_contact_email = support_email %}
{% set email_body %}{% if first_name is string and first_name|trim %}Hi {{ first_name|e }}, you{% else %}You{% endif %} asked for help accessing your {{ brand_name }} account. Open your account below and follow the sign-in steps.{% endset %}
{% include 'shared/document-start' %}

          <tr>
            <td style="padding:0 {{ space_gutter }};">
              {% set stack_eyebrow = 'Account access' %}
              {% set stack_title = email_title %}
              {% set stack_body = email_body %}
              {% include 'shared/components/text-stack' %}

              {% set card_body %}
                {% set detail_label = 'Use the same email' %}
                {% set detail_value = 'Sign in with the email address you used for your subscription purchase.' %}
                {% set detail_emphasis = true %}
                {% include 'shared/components/detail' %}

                {% set detail_label = 'First time signing in?' %}
                {% set detail_value = 'Follow the steps shown on your account page to get access. If you need help, contact us below.' %}
                {% set detail_space_above = space_md %}
                {% include 'shared/components/detail' %}
              {% endset %}
              {% include 'shared/components/card' %}

              {% set recharge_action_label = 'Open your account' %}
              {% include 'shared/components/recharge-actions' %}
            </td>
          </tr>

          {% set recharge_access_mode = 'account' %}
          {% include 'shared/components/recharge-account-help' %}
{% set footer_support_title = 'Need help accessing your account?' %}
{% include 'shared/document-end' %}
