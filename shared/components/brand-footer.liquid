<!-- ===== Porrada email header / footer bar ===== -->
<style>
  @media only screen and (max-width: 480px) {
    .pr-pad    { padding: 20px 20px !important; }
    .pr-icon   { width: 28px !important; height: 28px !important; }
    .pr-gap    { padding-left: 16px !important; }
  }
</style>

<table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" bgcolor="#000000" style="<meta charset='utf-8'>background-color:{{c_white}}; background-image:linear-gradient({{ c_white }},{{ c_white }});">
  <tr>
    <td align="center">
      <table role="presentation" width="600" cellpadding="0" cellspacing="0" border="0" style="width:100%;max-width:600px;<meta charset='utf-8'>background-color:{{c_white}}; background-image:linear-gradient({{ c_white }},{{ c_white }});">
        <tr>
          <!-- Wordmark -->
          <td class="pr-pad" width="60%" valign="middle" align="left" style="padding:44px 0 44px 24px;">
           
              <img src="{{img_footer_logo}}" width="200" alt="Porrada Performance Nutrition"
                   style="display:block;width:100%;max-width:200px;height:auto;border:0;outline:none;text-decoration:none;">
          
          </td>

          <!-- Social icons -->
          <td class="pr-pad" width="40%" valign="middle" align="right" style="padding:44px 24px 44px 0;">
            <table role="presentation" cellpadding="0" cellspacing="0" border="0" align="right">
              <tr>
                <td valign="middle">
                  <a href="https://www.tiktok.com/@porradanutra" target="_blank" style="text-decoration:none;">
                    <img class="pr-icon" src="https://cdn.klaviyomail.com/company/Wf5b2j/images/e36d1f2c-59e8-463b-af78-6ad1c517e707.png" width="36" height="36" alt="X"
                         style="display:block;width:36px;height:36px;border:0;outline:none;">
                  </a>
                </td>
                <td class="pr-gap" valign="middle" style="padding-left:28px;">
                  <a href="https://www.facebook.com/porradanutra" target="_blank" style="text-decoration:none;">
                    <img class="pr-icon" src="https://cdn.klaviyomail.com/company/Wf5b2j/images/043e8f86-b83a-4c76-98a6-8a19ba74549b.png" width="36" height="36" alt="Facebook"
                         style="display:block;width:36px;height:36px;border:0;outline:none;">
                  </a>
                </td>
                <td class="pr-gap" valign="middle" style="padding-left:28px;">
                  <a href="https://www.instagram.com/porradanutra/" target="_blank" style="text-decoration:none;">
                    <img class="pr-icon" src="https://cdn.klaviyomail.com/company/Wf5b2j/images/71ecb587-0dc8-4fdd-8fe5-743dab3a7e11.png" width="36" height="36" alt="Instagram"
                         style="display:block;width:36px;height:36px;border:0;outline:none;">
                  </a>
                </td>
              </tr>
            </table>
          </td>
        </tr>
      </table>
    </td>
  </tr>
</table>
<!-- ===== /Porrada email header / footer bar ===== -->