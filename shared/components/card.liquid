{%- comment -%}
  Card. A hairline-bordered box for the facts a customer looks for first,
  like delivery date and tracking. Place inside a <td>, usually between a
  text stack and its actions. Fill it with details.
  Input, reset after use:
    card_body  captured markup
{%- endcomment -%}
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="width:100%; margin-top:{{ space_lg }}; border:1px solid {{ c_divider }}; box-shadow: {{ c_shadow }}; border-radius:{{ radius_card }};">
  <tr>
    <td style="padding:{{ space_md }};">{{ card_body }}</td>
  </tr>
</table>
{%- assign card_body = '' -%}
