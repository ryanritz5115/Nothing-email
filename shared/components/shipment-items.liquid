{%- comment -%}
  Shipment items. Section rows: "Items in this shipment" and one line item
  per fulfillment line, without prices. Shows "1 of 2" when only part of
  a line ships. Place as body rows.
{%- endcomment -%}
{%- if fulfillment.fulfillment_line_items != blank -%}
{%- assign section_title = 'Items in this shipment' -%}
{%- include 'shared/components/section-heading' -%}

<tr>
  <td style="padding:0 {{ space_gutter }};">
    <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="width:100%;">
      {%- for fl in fulfillment.fulfillment_line_items -%}
        {%- assign item = fl.line_item -%}
        {%- if fl.quantity < fl.line_item.quantity -%}
          {%- assign item_quantity = fl.quantity | append: ' of ' | append: fl.line_item.quantity -%}
        {%- else -%}
          {%- assign item_quantity = fl.quantity -%}
        {%- endif -%}
        {%- include 'shared/components/line-item' -%}
      {%- endfor -%}
    </table>
  </td>
</tr>
{%- endif -%}
