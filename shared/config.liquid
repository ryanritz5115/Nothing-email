{%- comment -%}
=====================================================================
  PORRADA EMAIL · SHARED CONFIG
  Included first by every template. Single source of truth for
  colors, type, spacing, sizes, images, and links.
=====================================================================
{%- endcomment -%}

{%- comment -%} Colors {%- endcomment -%}
{%- assign c_black   = '#000000' -%}
{%- assign c_white   = '#F7F7F5' -%}
{%- assign c_gray    = '#555555' -%}
{%- assign c_brand   = '#000000' -%}
{%- assign c_shadow   = '0px 4px 8px 0px rgba(0,0,0,0.15)' -%}
{%- assign c_divider = '#f1f1f1' -%}{%- comment -%} hairline dividers only {%- endcomment -%}
{%- comment -%} Template-owned default; Recharge does not supply a design tone. {%- endcomment -%}
{%- assign tone = 'light' -%}

{%- comment -%} Type {%- endcomment -%}
{%- assign font_serif     = "system-ui, Arial, Helvetica, sans-serif" -%}
{%- assign font_sans      = "system-ui, Arial, Helvetica, sans-serif" -%}
{%- assign size_serif     = '32px' -%}
{%- assign size_body      = '16px' -%}
{%- assign size_small     = '12px' -%}
{%- assign weight_regular = '400' -%}
{%- assign weight_bold    = '700' -%}
{%- assign lh_serif       = '1.15' -%}
{%- assign lh_body        = '1.5' -%}
{%- assign lh_small       = '1.6' -%}

{%- comment -%} Spacing scale {%- endcomment -%}
{%- assign space_2xs    = '4px' -%}
{%- assign space_xs     = '8px' -%}
{%- assign space_sm     = '12px' -%}
{%- assign space_md     = '16px' -%}
{%- assign space_lg     = '24px' -%}
{%- assign space_xl     = '32px' -%}
{%- assign space_2xl    = '48px' -%}
{%- assign space_3xl    = '64px' -%}
{%- assign space_gutter = '20px' -%}{%- comment -%} left/right page padding {%- endcomment -%}

{%- comment -%} Sizes (unitless where used as width attributes) {%- endcomment -%}
{%- assign container_width    = '600' -%}
{%- assign logo_width         = '170' -%}
{%- assign product_image_size = '58' -%}
{%- assign card_icon_width    = '26' -%}
{%- assign discount_icon_size = '12' -%}
{%- assign footer_logo_width  = '300' -%}
{%- assign social_icon_size   = '36' -%}
{%- assign social_icon_mobile = '28' -%}
{%- assign footer_breakpoint  = '480px' -%}
{%- assign footer_brand_width = '60%' -%}
{%- assign footer_links_width = '40%' -%}
{%- assign totals_width       = '60%' -%}
{%- assign totals_spacer_width = '40%' -%}{%- comment -%} 100% minus totals_width {%- endcomment -%}
{%- assign radius_button      = '999px' -%}
{%- assign radius_image       = '8px' -%}
{%- assign radius_card        = '24px' -%}
{%- assign button_padding     = '16px 28px' -%}

