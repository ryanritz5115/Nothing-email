{%- comment -%} Links. Hardcoded: in a headless store shop.url can resolve to the wrong domain. {%- endcomment -%}
{%- assign store_url     = 'https://nothingsmells.com' -%}
{%- assign account_url   = 'https://nothingsmells.com/account' -%}
{%- assign support_url   = 'https://nothingsmells.com/support' -%}
{%- assign orders_url   = 'https://nothingsmells.com/account/orders' -%}
{%- assign support_email = 'support@nothingsmells.com' -%}
{%- assign tiktok_url    = 'https://www.tiktok.com/@nothingsmells' -%}
{%- assign facebook_url  = 'https://www.facebook.com/nothingsmells' -%}
{%- assign instagram_url = 'https://www.instagram.com/nothingsmells/' -%}
{%- assign gift_cart_url = store_url | append: '/api/cart/add' -%}
{%- assign gift_share_url = store_url | append: '/link-copy' -%}

{%- comment -%} ===================== STYLE TOKENS ===================== {%- endcomment -%}
{%- comment -%} Compose inline styles from tokens. Append color per use: style="{{ st_body }} color:{{ c_black }};" {%- endcomment -%}

{%- capture st_serif -%}margin:0; font-family:{{ font_serif }}; font-size:{{ size_serif }}; font-weight:{{ weight_regular }}; line-height:{{ lh_serif }};{%- endcapture -%}
{%- capture st_body -%}margin:0; font-family:{{ font_sans }}; font-size:{{ size_body }}; font-weight:{{ weight_regular }}; line-height:{{ lh_body }};{%- endcapture -%}
{%- capture st_body_bold -%}margin:0; font-family:{{ font_sans }}; font-size:{{ size_body }}; font-weight:{{ weight_bold }}; line-height:{{ lh_body }};{%- endcapture -%}
{%- capture st_small -%}margin:0; font-family:{{ font_sans }}; font-size:{{ size_small }}; font-weight:{{ weight_regular }}; line-height:{{ lh_small }};{%- endcapture -%}
{%- capture st_small_bold -%}margin:0; font-family:{{ font_sans }}; font-size:{{ size_small }}; font-weight:{{ weight_bold }}; line-height:{{ lh_small }};{%- endcapture -%}

{%- comment -%}
  Gift card and store credit bodies. Preserve the supplied gift design inside
  the shared header and footer. Both notifications reuse these tokens.
{%- endcomment -%}
{%- assign gc_width = '450' -%}
{%- assign gc_image_width = '402' -%}
{%- assign gc_radius_image = '14px' -%}
{%- assign gc_font_serif = "system-ui,'Helvetica Neue',Helvetica,Arial,sans-serif" -%}
{%- assign gc_font_sans = "system-ui,'Helvetica Neue',Helvetica,Arial,sans-serif" -%}
{%- assign gc_c_text = '#111111' -%}
{%- assign gc_c_body = '#444444' -%}
{%- assign gc_c_message = '#666666' -%}
{%- assign gc_c_muted = '#8a8a8a' -%}
{%- assign gc_c_badge = '#f2f2f2' -%}
{%- assign gc_size_title_mobile = '28px' -%}
{%- assign gc_size_heading_mobile = '26px' -%}
{%- assign gc_size_amount_mobile = '38px' -%}
{%- assign gc_size_step_mobile = '24px' -%}
{%- assign gc_pad_title = '0 24px 0' -%}
{%- assign gc_pad_intro = '14px 24px 0' -%}
{%- assign gc_pad_message = '16px 24px 0' -%}
{%- assign gc_pad_image = '28px 24px 0' -%}
{%- assign gc_pad_amount = '26px 24px 0' -%}
{%- assign gc_pad_note = '10px 24px 0' -%}
{%- assign gc_pad_action = '24px 24px 0' -%}
{%- assign gc_pad_share = '12px 24px 0' -%}
{%- assign gc_pad_code = '20px 24px 0' -%}
{%- assign gc_pad_heading = '52px 24px 0' -%}
{%- assign gc_pad_step = '36px 24px 0' -%}
{%- assign gc_pad_wallet = '40px 24px 0' -%}
{%- assign gc_wallet_width = '120' -%}
{%- assign gc_wallet_height = '40' -%}
{%- capture st_gc_title -%}font-family:{{ gc_font_serif }}; font-size:32px; line-height:1.2; color:{{ gc_c_text }}; letter-spacing:-0.01em;{%- endcapture -%}
{%- capture st_gc_body -%}font-family:{{ gc_font_sans }}; font-size:14px; line-height:1.6; color:{{ gc_c_body }}; overflow-wrap:anywhere; word-break:break-word;{%- endcapture -%}
{%- capture st_gc_message -%}font-family:{{ gc_font_serif }}; font-size:16px; line-height:1.55; color:{{ gc_c_message }}; font-style:italic; overflow-wrap:anywhere; word-break:break-word;{%- endcapture -%}
{%- capture st_gc_amount -%}font-family:{{ gc_font_serif }}; font-size:44px; line-height:1; color:{{ gc_c_text }}; letter-spacing:-0.02em;{%- endcapture -%}
{%- capture st_gc_note -%}font-family:{{ gc_font_sans }}; font-size:12px; line-height:1.4; color:{{ gc_c_muted }};{%- endcapture -%}
{%- capture st_gc_button -%}display:inline-block; padding:14px 34px; border-radius:{{ radius_button }}; font-family:{{ gc_font_sans }}; font-size:14px; line-height:1; font-weight:600; color:{{ c_white }}; text-decoration:none;{%- endcapture -%}
{%- capture st_gc_share -%}display:inline-block; padding:12px 32px; border:2px solid {{ c_brand }}; border-radius:{{ radius_button }}; font-family:{{ gc_font_sans }}; font-size:14px; line-height:1; font-weight:600; color:{{ c_brand }}; text-decoration:none;{%- endcapture -%}
{%- capture st_gc_code_label -%}font-family:{{ gc_font_sans }}; font-size:12px; line-height:1.5; color:{{ gc_c_muted }};{%- endcapture -%}
{%- capture st_gc_code -%}display:inline-block; padding-top:4px; font-family:{{ gc_font_sans }}; font-size:16px; letter-spacing:2px; color:{{ gc_c_text }}; font-weight:500; overflow-wrap:anywhere; word-break:break-word;{%- endcapture -%}
{%- capture st_gc_heading -%}font-family:{{ gc_font_serif }}; font-size:30px; line-height:1.2; color:{{ gc_c_text }}; letter-spacing:-0.01em;{%- endcapture -%}
{%- capture st_gc_badge -%}border-radius:{{ radius_button }}; background-color:{{ gc_c_badge }}; padding:5px 12px; font-family:{{ gc_font_sans }}; font-size:11px; line-height:1; font-weight:600; color:{{ c_gray }};{%- endcapture -%}
{%- capture st_gc_step -%}font-family:{{ gc_font_serif }}; font-size:27px; line-height:1.2; color:{{ gc_c_text }}; letter-spacing:-0.01em;{%- endcapture -%}
