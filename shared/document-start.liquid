{%- comment -%}
  Opens the document: head, preheader, page wrapper, container, logo.
  Set before including: email_title, preheader
{%- endcomment -%}
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="color-scheme" content="light only">
  <meta name="supported-color-schemes" content="light only">
  <title>{{ email_title }}</title>
  <style>
    :root { color-scheme: light only; }
    body { margin:0; padding:0; -webkit-text-size-adjust:100%; }
    img { border:0; outline:none; text-decoration:none; display:block; }
    a { text-decoration:none; }
  </style>
</head>
<body style="margin:0; padding:0; background-color:{{ c_white }};">

  <div style="display:none; max-height:0; overflow:hidden; opacity:0; mso-hide:all;">{{ preheader }}</div>

  <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" bgcolor="{{ c_white }}" style="background-color:{{ c_white }};">
    <tr>
      <td align="center">
        <table role="presentation" width="{{ container_width }}" cellpadding="0" cellspacing="0" border="0" style="width:100%; max-width:{{ container_width }}px;">

          <tr>
            <td align="center" style="padding:{{ space_xl }} {{ space_gutter }} {{ space_2xl }};">
              <a href="{{ store_url }}" target="_blank">
                <img src="{{ img_logo }}" width="{{ logo_width }}" alt="Porrada Performance Nutrition" style="display:block; width:{{ logo_width }}px; max-width:100%; height:auto;">
              </a>
            </td>
          </tr>
