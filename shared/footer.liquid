{%- comment -%}
  Support footer. Full-bleed black row. The linear-gradient keeps it
  black in clients that force dark mode on background-color.
  Optional input, reset after use: footer_support_title.
  Support email always comes from shared config.
  Defaults preserve the order footer; Recharge supplies subscription wording.
{%- endcomment -%}
{%- if footer_support_title == blank -%}
  {%- assign footer_support_title = 'Need help with your order?' -%}
{%- endif -%}
    <tr>
      <td align="center" bgcolor="{{ c_black }}" style="background-color:{{ c_black }}; background-image:linear-gradient({{ c_black }},{{ c_black }});">
        <table role="presentation" width="{{ container_width }}" cellpadding="0" cellspacing="0" border="0" style="width:100%; max-width:{{ container_width }}px;">
          <tr>
            <td style="padding:{{ space_3xl }} {{ space_gutter }};">
              {%- assign tone = 'dark' -%}

              {%- assign stack_eyebrow = 'Support' -%}
              {%- assign stack_title   = footer_support_title -%}
              {%- assign stack_body    = 'Click below to contact support.' -%}
              {%- assign stack_tag     = 'h2' -%}
              {%- include 'shared/components/text-stack' -%}

              {%- assign button_label = 'Contact Support' -%}
              {%- assign button_url   = support_url -%}
              {%- assign link_prefix  = 'or email us directly at' -%}
              {%- assign link_label   = support_email | escape -%}
              {%- assign link_url     = 'mailto:' | append: support_email | escape -%}
              {%- include 'shared/components/actions' -%}

              {%- assign tone = 'light' -%}
            </td>
          </tr>
        </table>
      </td>
    </tr>

{%- include 'shared/components/brand-footer' -%}
{%- assign footer_support_title = nil -%}
