{%- comment -%}
=====================================================================
  ORDER CONFIRMATION
  Shopify > Settings > Notifications > Order confirmation
  Paste dist/shopify/order-confirmation.liquid, not this file.
=====================================================================
{%- endcomment -%}

{%- include 'shared/config' -%}

{%- comment -%} Template behavior {%- endcomment -%}
{%- assign show_paid_today_always = false -%}{%- comment -%} true = always show "Total paid today", even when it equals the total {%- endcomment -%}

{%- comment -%} Flat on purpose: a nested width="100%" table collapses to a dot in Gmail iOS. {%- endcomment -%}
{%- capture totals_divider -%}
<tr><td colspan="2" style="height:{{ space_sm }}; font-size:0; line-height:0;">&nbsp;</td></tr>
<tr><td colspan="2" style="border-top:1px solid {{ c_divider }}; height:{{ space_sm }}; font-size:0; line-height:0;">&nbsp;</td></tr>
{%- endcapture -%}

{%- comment -%} ======================= ORDER LOGIC ======================= {%- endcomment -%}

{%- comment -%} Headline + intro copy {%- endcomment -%}
{%- if has_pending_payment -%}
  {%- assign email_title = 'Thank you for your order!' -%}
  {%- if buyer_action_required -%}
    {%- assign email_body = "Complete your payment to confirm your order. You'll get a confirmation email once it goes through." -%}
  {%- else -%}
    {%- assign email_body = "Your payment is being processed. You'll get an email when your order is confirmed." -%}
  {%- endif -%}
{%- else -%}
  {%- assign email_title = 'Thank you for your purchase!' -%}
  {%- if requires_shipping -%}
    {%- case delivery_method -%}
      {%- when 'pick-up' -%}
        {%- assign email_body = "You'll receive an email when your order is ready for pickup." -%}
      {%- when 'local' -%}
        {%- assign email_body = "We're getting your order ready for delivery." -%}
      {%- else -%}
        {%- assign email_body = 'You will receive an email with your products shortly.' -%}
    {%- endcase -%}
  {%- else -%}
    {%- assign email_body = 'Your order is confirmed.' -%}
  {%- endif -%}
{%- endif -%}

{%- assign preheader = 'Order ' | append: order_name | append: " confirmed. Here's your summary." -%}

{%- comment -%} Gift card note {%- endcomment -%}
{%- assign gift_card_note = '' -%}
{%- assign gift_card_lines = line_items | where: 'gift_card' -%}
{%- if gift_card_lines.size > 0 -%}
  {%- assign gift_card_to_recipient = false -%}
  {%- for gl in gift_card_lines -%}
    {%- if gl.properties['__shopify_send_gift_card_to_recipient'] and gl.properties['Recipient email'] -%}
      {%- assign gift_card_to_recipient = true -%}
      {%- break -%}
    {%- endif -%}
  {%- endfor -%}
  {%- if gift_card_to_recipient -%}
    {%- assign gift_card_note = 'Your gift card recipient will receive an email with their gift card code.' -%}
  {%- else -%}
    {%- assign gift_card_note = "You'll receive separate emails for any gift cards." -%}
  {%- endif -%}
{%- endif -%}

{%- comment -%} Discounts: order-level and shipping {%- endcomment -%}
{%- assign order_discount_count    = 0 -%}
{%- assign order_discount_total    = 0 -%}
{%- assign shipping_discount_total = 0 -%}
{%- assign has_shipping_discount   = false -%}
{%- for app in discount_applications -%}
  {%- if app.target_selection == 'all' and app.target_type == 'line_item' -%}
    {%- assign order_discount_count = order_discount_count | plus: 1 -%}
    {%- assign order_discount_total = order_discount_total | plus: app.total_allocated_amount -%}
  {%- elsif app.target_type == 'shipping_line' -%}
    {%- assign has_shipping_discount = true -%}
    {%- assign shipping_discount_total = shipping_discount_total | plus: app.total_allocated_amount -%}
  {%- endif -%}
{%- endfor -%}
{%- assign shipping_original = shipping_price | plus: shipping_discount_total -%}

{%- comment -%} Delivery labels {%- endcomment -%}
{%- case delivery_method -%}
  {%- when 'pick-up' -%}
    {%- assign delivery_label = 'Pickup' -%}
    {%- assign method_label   = 'Pickup' -%}
    {%- assign address_label  = '' -%}
  {%- when 'local' -%}
    {%- assign delivery_label = 'Delivery' -%}
    {%- assign method_label   = 'Delivery method' -%}
    {%- assign address_label  = 'Delivery address' -%}
  {%- else -%}
    {%- assign delivery_label = 'Shipping' -%}
    {%- assign method_label   = 'Shipping method' -%}
    {%- assign address_label  = 'Shipping address' -%}
{%- endcase -%}

{%- comment -%} Payments {%- endcomment -%}
{%- assign paid_amount       = 0 -%}
{%- assign authorized_amount = 0 -%}
{%- assign refunded_amount   = 0 -%}
{%- assign payment_count     = 0 -%}
{%- for t in transactions -%}
  {%- if t.status == 'success' -%}
    {%- case t.kind -%}
      {%- when 'sale', 'capture' -%}
        {%- assign paid_amount = paid_amount | plus: t.amount -%}
        {%- assign payment_count = payment_count | plus: 1 -%}
      {%- when 'authorization' -%}
        {%- assign authorized_amount = authorized_amount | plus: t.amount -%}
        {%- assign payment_count = payment_count | plus: 1 -%}
      {%- when 'refund' -%}
        {%- assign refunded_amount = refunded_amount | plus: t.amount -%}
    {%- endcase -%}
  {%- endif -%}
{%- endfor -%}

{%- assign show_paid_today = false -%}
{%- if paid_amount > 0 -%}
  {%- if show_paid_today_always or paid_amount != total_price or total_outstanding > 0 -%}
    {%- assign show_paid_today = true -%}
  {%- endif -%}
{%- endif -%}

{%- assign show_ship_address = false -%}
{%- if requires_shipping and shipping_address and delivery_method != 'pick-up' -%}
  {%- assign show_ship_address = true -%}
{%- endif -%}

{%- assign address = shipping_address -%}
{%- capture ship_address_lines -%}{%- include 'shared/components/address' -%}{%- endcapture -%}
{%- assign address = billing_address -%}
{%- capture bill_address_lines -%}{%- include 'shared/components/address' -%}{%- endcapture -%}

{%- comment -%} ========================= DOCUMENT ========================= {%- endcomment -%}

{%- include 'shared/document-start' -%}

          {%- comment -%} ===== HERO ===== {%- endcomment -%}
          <tr>
            <td style="padding:0 {{ space_gutter }};">
              {%- assign stack_eyebrow = 'Order ' | append: order_name -%}
              {%- assign stack_title   = email_title -%}
              {%- assign stack_body    = email_body -%}
              {%- include 'shared/components/text-stack' -%}

              {%- if delivery_method == 'local' and delivery_instructions != blank -%}
                <p style="{{ st_body }} color:{{ c_black }}; padding-top:{{ space_xs }};"><strong>Delivery information:</strong> {{ delivery_instructions }}</p>
              {%- endif -%}

              {%- if gift_card_note != '' -%}
                <p style="{{ st_body }} color:{{ c_black }}; padding-top:{{ space_xs }};">{{ gift_card_note }}</p>
              {%- endif -%}

              {%- assign button_label = 'View your order' -%}
              {%- assign button_url   = orders_url -%}
              {%- assign link_prefix  = 'or' -%}
              {%- assign link_label   = 'Visit our store' -%}
              {%- assign link_url     = store_url -%}
              {%- include 'shared/components/actions' -%}
            </td>
          </tr>

          {%- comment -%} ===== ORDER SUMMARY ===== {%- endcomment -%}
          {%- assign section_title = 'Order summary' -%}
          {%- include 'shared/components/section-heading' -%}

          <tr>
            <td style="padding:0 {{ space_gutter }};">
              <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="width:100%;">
                {%- for line in subtotal_line_items -%}
                  {%- assign item            = line -%}
                  {%- assign item_show_price = true -%}
                  {%- include 'shared/components/line-item' -%}
                {%- endfor -%}
              </table>
            </td>
          </tr>

          {%- comment -%} ===== TOTALS ===== {%- endcomment -%}
          <tr>
            <td style="padding:{{ space_lg }} {{ space_gutter }} 0;">
              <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="width:100%;">
                <tr>
                  <td width="{{ totals_spacer_width }}" style="width:{{ totals_spacer_width }}; font-size:0; line-height:0;">&nbsp;</td>
                  <td width="{{ totals_width }}" style="width:{{ totals_width }};">
                    <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="width:100%;">

                      <tr>
                        <td style="padding:{{ space_2xs }} 0;"><p style="{{ st_small }} color:{{ c_gray }};">Subtotal</p></td>
                        <td align="right" style="padding:{{ space_2xs }} 0;"><p style="{{ st_small_bold }} color:{{ c_gray }};">{{ subtotal_price | money }}</p></td>
                      </tr>

                      {%- if order_discount_count > 0 -%}
                        <tr>
                          <td style="padding:{{ space_2xs }} 0;"><p style="{{ st_small }} color:{{ c_gray }};">{%- if order_discount_count > 1 -%}Order discounts{%- else -%}Order discount{%- endif -%}</p></td>
                          <td align="right" style="padding:{{ space_2xs }} 0;"><p style="{{ st_small_bold }} color:{{ c_gray }};">-{{ order_discount_total | money }}</p></td>
                        </tr>
                        {%- for app in discount_applications -%}
                          {%- if app.target_selection == 'all' and app.target_type == 'line_item' -%}
                            <tr>
                              <td colspan="2" style="padding:0 0 {{ space_2xs }};">
                                <table role="presentation" cellpadding="0" cellspacing="0" border="0">
                                  <tr>
                                    {%- if img_discount_tag != '' -%}
                                      <td valign="middle" style="padding:0 {{ space_2xs }} 0 {{ space_xs }};"><img src="{{ img_discount_tag }}" width="{{ discount_icon_size }}" height="{{ discount_icon_size }}" alt="" style="display:block;"></td>
                                    {%- endif -%}
                                    <td valign="middle"><p style="{{ st_small }} color:{{ c_gray }};">{{ app.title | upcase }} (-{{ app.total_allocated_amount | money }})</p></td>
                                  </tr>
                                </table>
                              </td>
                            </tr>
                          {%- endif -%}
                        {%- endfor -%}
                      {%- endif -%}

                      {%- if requires_shipping -%}
                        <tr>
                          <td style="padding:{{ space_2xs }} 0;"><p style="{{ st_small }} color:{{ c_gray }};">{{ delivery_label }}</p></td>
                          <td align="right" style="padding:{{ space_2xs }} 0; white-space:nowrap;">
                            <p style="{{ st_small_bold }} color:{{ c_gray }};">
                              {%- if has_shipping_discount and shipping_original > shipping_price -%}
                                <del style="font-weight:{{ weight_regular }};">{{ shipping_original | money }}</del>&nbsp;&nbsp;
                              {%- endif -%}
                              {%- if shipping_price > 0 -%}{{ shipping_price | money }}{%- else -%}Free{%- endif -%}
                            </p>
                          </td>
                        </tr>
                        {%- if has_shipping_discount -%}
                          {%- for app in discount_applications -%}
                            {%- if app.target_type == 'shipping_line' -%}
                              <tr>
                                <td colspan="2" style="padding:0 0 {{ space_2xs }};">
                                  <table role="presentation" cellpadding="0" cellspacing="0" border="0">
                                    <tr>
                                      {%- if img_discount_tag != '' -%}
                                        <td valign="middle" style="padding:0 {{ space_2xs }} 0 {{ space_xs }};"><img src="{{ img_discount_tag }}" width="{{ discount_icon_size }}" height="{{ discount_icon_size }}" alt="" style="display:block;"></td>
                                      {%- endif -%}
                                      <td valign="middle"><p style="{{ st_small }} color:{{ c_gray }};">{{ app.title | upcase }} (-{{ app.total_allocated_amount | money }})</p></td>
                                    </tr>
                                  </table>
                                </td>
                              </tr>
                            {%- endif -%}
                          {%- endfor -%}
                        {%- endif -%}
                      {%- endif -%}

                      {%- if total_duties -%}
                        <tr>
                          <td style="padding:{{ space_2xs }} 0;"><p style="{{ st_small }} color:{{ c_gray }};">Duties</p></td>
                          <td align="right" style="padding:{{ space_2xs }} 0;"><p style="{{ st_small_bold }} color:{{ c_gray }};">{{ total_duties | money }}</p></td>
                        </tr>
                      {%- endif -%}

                      <tr>
                        <td style="padding:{{ space_2xs }} 0;"><p style="{{ st_small }} color:{{ c_gray }};">{%- if taxes_included -%}Taxes (included){%- else -%}Taxes{%- endif -%}</p></td>
                        <td align="right" style="padding:{{ space_2xs }} 0;"><p style="{{ st_small_bold }} color:{{ c_gray }};">{{ tax_price | money }}</p></td>
                      </tr>

                      {%- if total_tip and total_tip > 0 -%}
                        <tr>
                          <td style="padding:{{ space_2xs }} 0;"><p style="{{ st_small }} color:{{ c_gray }};">Tip</p></td>
                          <td align="right" style="padding:{{ space_2xs }} 0;"><p style="{{ st_small_bold }} color:{{ c_gray }};">{{ total_tip | money }}</p></td>
                        </tr>
                      {%- endif -%}

                      {{ totals_divider }}

                      <tr>
                        <td valign="middle"><p style="{{ st_small }} color:{{ c_gray }};">Total</p></td>
                        <td align="right" valign="middle" style="white-space:nowrap;"><p style="{{ st_body_bold }} color:{{ c_gray }};">{{ total_price | money_with_currency }}</p></td>
                      </tr>

                      {%- if total_discounts > 0 -%}
                        <tr>
                          <td colspan="2" align="right" style="padding-top:{{ space_xs }};"><p style="{{ st_small }} color:{{ c_gray }};">You saved {{ total_discounts | money }}</p></td>
                        </tr>
                      {%- endif -%}

                      {%- if show_paid_today or authorized_amount > 0 or total_outstanding > 0 or refunded_amount > 0 -%}
                        {{ totals_divider }}
                      {%- endif -%}

                      {%- if show_paid_today -%}
                        <tr>
                          <td style="padding:{{ space_2xs }} 0;"><p style="{{ st_small }} color:{{ c_gray }};">Total paid today</p></td>
                          <td align="right" style="padding:{{ space_2xs }} 0;"><p style="{{ st_small_bold }} color:{{ c_gray }};">{{ paid_amount | money_with_currency }}</p></td>
                        </tr>
                      {%- endif -%}

                      {%- if authorized_amount > 0 -%}
                        <tr>
                          <td style="padding:{{ space_2xs }} 0;"><p style="{{ st_small }} color:{{ c_gray }};">Authorized, not yet charged</p></td>
                          <td align="right" style="padding:{{ space_2xs }} 0;"><p style="{{ st_small_bold }} color:{{ c_gray }};">{{ authorized_amount | money_with_currency }}</p></td>
                        </tr>
                      {%- endif -%}

                      {%- if total_outstanding > 0 -%}
                        <tr>
                          <td style="padding:{{ space_2xs }} 0;"><p style="{{ st_small }} color:{{ c_gray }};">Amount due{%- if payment_terms.next_payment.due_at %} by {{ payment_terms.next_payment.due_at | date: '%b %-d, %Y' }}{%- endif -%}</p></td>
                          <td align="right" style="padding:{{ space_2xs }} 0;"><p style="{{ st_small_bold }} color:{{ c_gray }};">{{ total_outstanding | money_with_currency }}</p></td>
                        </tr>
                      {%- endif -%}

                      {%- if refunded_amount > 0 -%}
                        <tr>
                          <td style="padding:{{ space_2xs }} 0;"><p style="{{ st_small }} color:{{ c_gray }};">Refunded</p></td>
                          <td align="right" style="padding:{{ space_2xs }} 0;"><p style="{{ st_small_bold }} color:{{ c_gray }};">-{{ refunded_amount | money }}</p></td>
                        </tr>
                      {%- endif -%}

                      {%- if payment_count > 0 -%}
                        {{ totals_divider }}
                        {%- for t in transactions -%}
                          {%- if t.status == 'success' -%}
                            {%- if t.kind == 'sale' or t.kind == 'capture' or t.kind == 'authorization' -%}
                              <tr>
                                <td style="padding:{{ space_2xs }} 0;">
                                  <p style="{{ st_small }} color:{{ c_gray }};">
                                    {%- if t.gateway == 'gift_card' -%}
                                      Gift card{%- if t.payment_details.gift_card.last_four_characters %} (ending with {{ t.payment_details.gift_card.last_four_characters | upcase }}){%- endif -%}
                                    {%- elsif t.payment_details.credit_card_company -%}
                                      {{ t.payment_details.credit_card_company }}{%- if t.payment_details.credit_card_last_four_digits %} (ending in {{ t.payment_details.credit_card_last_four_digits }}){%- endif -%}
                                    {%- else -%}
                                      {{ t.gateway_display_name }}
                                    {%- endif -%}
                                  </p>
                                </td>
                                <td align="right" style="padding:{{ space_2xs }} 0;"><p style="{{ st_small_bold }} color:{{ c_gray }};">{{ t.amount | money }}</p></td>
                              </tr>
                            {%- endif -%}
                          {%- endif -%}
                        {%- endfor -%}
                      {%- endif -%}

                    </table>
                  </td>
                </tr>
              </table>
            </td>
          </tr>

          {%- comment -%} ===== CUSTOMER INFORMATION ===== {%- endcomment -%}
          {%- assign section_title = 'Customer information' -%}
          {%- include 'shared/components/section-heading' -%}

          {%- if show_ship_address or billing_address -%}
            <tr>
              <td style="padding:0 {{ space_gutter }};">
                <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="width:100%;">
                  <tr>
                    {%- if show_ship_address -%}
                      <td width="50%" valign="top" style="width:50%; padding-right:{{ space_md }};">
                        {%- assign detail_label = address_label -%}
                        {%- assign detail_value = ship_address_lines -%}
                        {%- include 'shared/components/detail' -%}
                      </td>
                    {%- endif -%}
                    {%- if billing_address -%}
                      <td width="50%" valign="top" style="width:50%;">
                        {%- assign detail_label = 'Billing address' -%}
                        {%- assign detail_value = bill_address_lines -%}
                        {%- include 'shared/components/detail' -%}
                      </td>
                    {%- endif -%}
                  </tr>
                </table>
              </td>
            </tr>
          {%- endif -%}

          {%- comment -%} Payment {%- endcomment -%}
          {%- if payment_count > 0 or payment_terms or gateway -%}
            <tr>
              <td style="padding:{{ space_lg }} {{ space_gutter }} 0;">
                {%- assign detail_label = 'Payment' -%}
                {%- include 'shared/components/detail' -%}

                {%- if payment_count > 0 -%}
                  {%- for t in transactions -%}
                    {%- if t.status == 'success' -%}
                      {%- if t.kind == 'sale' or t.kind == 'capture' or t.kind == 'authorization' -%}
                        {%- assign card_img = '' -%}
                        {%- assign card_brand = t.payment_details.credit_card_company | downcase -%}
                        {%- case card_brand -%}
                          {%- when 'visa' -%}{%- assign card_img = img_card_visa -%}
                          {%- when 'mastercard' -%}{%- assign card_img = img_card_mastercard -%}
                          {%- when 'american express' -%}{%- assign card_img = img_card_amex -%}
                          {%- when 'discover' -%}{%- assign card_img = img_card_discover -%}
                          {%- when 'jcb' -%}{%- assign card_img = img_card_jcb -%}
                          {%- when 'diners club' -%}{%- assign card_img = img_card_diners -%}
                          {%- when 'unionpay', 'china unionpay' -%}{%- assign card_img = img_card_unionpay -%}
                        {%- endcase -%}
                        <table role="presentation" cellpadding="0" cellspacing="0" border="0" style="margin-top:{{ space_xs }};">
                          <tr>
                            {%- if t.gateway == 'gift_card' -%}
                              <td valign="middle"><p style="{{ st_small }} color:{{ c_gray }};">Gift card{%- if t.payment_details.gift_card.last_four_characters %} ending with {{ t.payment_details.gift_card.last_four_characters | upcase }}{%- endif -%}</p></td>
                            {%- elsif t.payment_details.credit_card_company -%}
                              {%- if card_img != '' -%}
                                <td valign="middle" style="padding-right:{{ space_sm }};"><img src="{{ card_img }}" width="{{ card_icon_width }}" alt="{{ t.payment_details.credit_card_company | escape }}" style="display:block; width:{{ card_icon_width }}px; height:auto;"></td>
                                <td valign="middle"><p style="{{ st_small }} color:{{ c_gray }};">ending with {{ t.payment_details.credit_card_last_four_digits }}</p></td>
                              {%- else -%}
                                <td valign="middle"><p style="{{ st_small }} color:{{ c_gray }};">{{ t.payment_details.credit_card_company }} ending with {{ t.payment_details.credit_card_last_four_digits }}</p></td>
                              {%- endif -%}
                            {%- else -%}
                              <td valign="middle"><p style="{{ st_small }} color:{{ c_gray }};">{{ t.gateway_display_name }}</p></td>
                            {%- endif -%}
                          </tr>
                        </table>
                      {%- endif -%}
                    {%- endif -%}
                  {%- endfor -%}
                {%- elsif gateway -%}
                  <p style="{{ st_small }} color:{{ c_gray }}; padding-top:{{ space_2xs }};">{{ gateway }}{%- if has_pending_payment %} (pending){%- endif -%}</p>
                {%- endif -%}

                {%- if payment_terms -%}
                  <p style="{{ st_small }} color:{{ c_gray }}; padding-top:{{ space_2xs }};">Payment terms: {{ payment_terms.payment_terms_name }}</p>
                {%- endif -%}
              </td>
            </tr>
          {%- endif -%}

          {%- comment -%} Shipping / delivery / pickup method {%- endcomment -%}
          {%- if requires_shipping and shipping_method -%}
            <tr>
              <td style="padding:{{ space_lg }} {{ space_gutter }} 0;">
                {%- assign detail_label = method_label -%}
                {%- assign detail_value = shipping_method.title -%}
                {%- include 'shared/components/detail' -%}
              </td>
            </tr>
          {%- endif -%}

          {%- comment -%} PO number (B2B) {%- endcomment -%}
          {%- if po_number -%}
            <tr>
              <td style="padding:{{ space_lg }} {{ space_gutter }} 0;">
                {%- assign detail_label = 'PO number' -%}
                {%- assign detail_value = po_number -%}
                {%- include 'shared/components/detail' -%}
              </td>
            </tr>
          {%- endif -%}

{%- include 'shared/document-end' -%}
